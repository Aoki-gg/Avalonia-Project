<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovoProjetoAvalonia.ViewModels"
             xmlns:viewmodels="using:NovoProjetoAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:DataType="vm:InicioViewModel"
             x:Class="NovoProjetoAvalonia.Views.InicioView">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Página Inicial" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Conteúdo do início aqui..."/>
    </StackPanel>

</UserControl>