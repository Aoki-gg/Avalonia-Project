<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovoProjetoAvalonia.ViewModels"
             x:DataType="vm:ContasSalvasViewModel"
             mc:Ignorable="d"
             x:Class="NovoProjetoAvalonia.Views.ContasSalvasView"
             MinHeight="450" MinWidth="450">
    
<Grid RowDefinitions="*, Auto" Margin="15">
        
        <!-- LINHA 0: O ScrollViewer que vai conter as caixinhas lado a lado -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Contas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- WrapPanel para as caixinhas ficarem lado a lado -->
                        <WrapPanel Orientation="Horizontal" ItemSpacing="50" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Suas caixinhas com margem para não grudarem -->
                        <Border Background="#2D2D2D" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                            <StackPanel Spacing="8" Width="150">
                                <!--<TextBlock Text="Nova Conta" FontWeight="Bold" Foreground="White"/>-->
                                <TextBox Watermark="Login" Text="{Binding Login}"/>
                                <TextBox Watermark="Senha" Text="{Binding Senha}" PasswordChar="*"/>
                                <TextBox Watermark="Personagem" Text="{Binding NomePersonagem}"/>
                                <TextBox Watermark="Classe" Text="{Binding Classe}"/>
                                <Button Content="Salvar" 
                                        Command="{Binding $parent[UserControl].((vm:ContasSalvasViewModel)DataContext).SalvarContaCommand}"
                                        CommandParameter="{Binding}" 
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="Remover" 
                                        Command="{Binding $parent[UserControl].((vm:ContasSalvasViewModel)DataContext).RemoverContaCommand}"
                                        CommandParameter="{Binding}" 
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="Jogar" 
                                        Command="{Binding $parent[UserControl].((vm:ContasSalvasViewModel)DataContext).JogarCommand}"
                                        CommandParameter="{Binding}" 
                                        HorizontalAlignment="Stretch"/>


                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    <!-- Botão de Salvar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="10">
    <Button Content="Novo personagem" Command="{Binding AdicionarContaCommand }"></Button>
    <Button Content="TestarSkill" Command="{Binding CancelarSkillCommand}"  />
        <Button Content="Nops" Command="{Binding HookCommand}"  />
        <!-- Texto de feedback para o utilizador saber que salvou -->
    <TextBlock Text="{Binding StatusMensagem}" 
               Foreground="LightGreen" 
               FontWeight="Bold" 
               HorizontalAlignment="Center" />

    <TextBlock Text="{Binding NomeDebug}" 
               Foreground="Yellow" 
               FontSize="16" 
               FontWeight="Bold" />
    </StackPanel>
</Grid>

</UserControl>
