<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NovoProjetoAvalonia.ViewModels"
             x:DataType="vm:RepositorioViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NovoProjetoAvalonia.Views.RepositorioView">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Repositório" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Gerenciamento de repositórios/swaps."/>
    </StackPanel>

</UserControl>